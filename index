          position: relative;
          overflow: hidden;
          border: 3px solid var(--tc, var(--behl-navy));
          background: linear-gradient(135deg, color-mix(in srgb, var(--tc, var(--behl-navy)) 10%, var(--pane)), var(--pane) 60%);
          box-shadow: 0 0 0 6px color-mix(in srgb, var(--tc, var(--behl-navy)) 12%, transparent);
        }
        .hd-pulse-dot {
          width: 16px; height: 16px; border-radius: 50%;
          background: var(--tc, var(--behl-navy));
          box-shadow: 0 0 0 0 color-mix(in srgb, var(--tc, var(--behl-navy)) 70%, transparent);
          animation: hd-pulse 1.6s ease-out infinite;
        }
        @keyframes hd-pulse {
          0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tc, var(--behl-navy)) 55%, transparent); }
          70% { box-shadow: 0 0 0 14px transparent; }
          100% { box-shadow: 0 0 0 0 transparent; }
        }
        .hd-pick-number {
          font-family: 'Oswald', sans-serif;
          font-weight: 700;
          font-size: 46px;
          line-height: 1;
          color: var(--tc, var(--behl-navy));
        }
        .hd-clock {
          font-family: 'Oswald', sans-serif;
