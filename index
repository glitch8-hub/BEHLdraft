              </button>
            </div>
            <div className="p-4 hd-scroll" style={{ overflowY: 'auto' }}>
              {Array.from({ length: totalRounds }).map((_, r) => {
                const roundPicks = picks.filter((p) => p.round === r + 1);
                if (roundPicks.length === 0) return null;
                return (
                  <div key={r} style={{ marginBottom: 14 }}>
                    <div className="hd-eyebrow mb-1">Round {r + 1}</div>
                    {roundPicks.map((p) => {
                      const player = players.find((pl) => pl.id === p.playerId);
                      const team = teams.find((tm) => tm.id === p.teamId);
                      return (
                        <div key={p.overall} className="hd-sum-row">
                          <span className="hd-sum-overall">#{p.overall}</span>
                          <span className="hd-sum-team">
                            {team && <img src={TEAM_LOGOS[team.id]} alt="" className="hd-team-logo" />}
                            <span className="truncate">{team ? team.name : '?'}</span>
                          </span>
                          <span className="hd-sum-player truncate">{player ? player.name : '?'}</span>
                          {player && player.pos && <span className="hd-pos-badge">{player.pos}</span>}
                          {(() => {
                            const owner = playerMoves[p.playerId] !== undefined ? playerMoves[p.playerId] : p.teamId;
                            if (owner === p.teamId) return null;
                            const now = teams.find((tm) => tm.id === owner);
                            return now ? <span className="hd-sum-moved">now {now.name}</span> : null;
                          })()}
                        </div>
                      );
                    })}
                  </div>
                );
              })}
              {tradeLog.length > 0 && (
                <div>
                  <div className="hd-eyebrow mb-1 flex items-center gap-1"><History size={12} /> Trades</div>
                  <div className="flex flex-col gap-1.5">
                    {tradeLog.slice().reverse().map((t) => (
                      <div key={t.id} className="text-xs hd-card px-2.5 py-2" style={{ color: 'var(--navy)' }}>
                        {t.text}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function ChevronRightIcon() {
  return (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <path d="M9 18l6-6-6-6" />
    </svg>
  );
}
