import React, { useState, useEffect, useMemo, useRef } from 'react';
import { Search, Undo2, Shuffle, ArrowUp, ArrowDown, Trophy, RotateCcw, X, Users, ArrowLeftRight, History, Play, Pause, TimerReset, ClipboardList } from 'lucide-react';

const TEAM_COLORS = ['#2E7D32', '#FFFFFF', '#1959B8', '#111318', '#C8102E', '#FFC72C'];
const TEAM_NAMES = ['Green', 'White', 'Blue', 'Black', 'Red', 'Yellow'];
const STORAGE_KEY = 'hockey-draft-state-v4';
const ROUND_SIZE = 6;
// Fixed team crests (BE shield in each jersey colour), embedded so the app stays self-contained.
const TEAM_LOGOS = [
  'data:image/png;base64,',
  'data:image/png;base64,',
  'data:image/png;base64,',
  'data:image/png;base64,',
  'data:image/png;base64,',
  'data:image/png;base64,',
];
const BANNER_SRC = 'data:image/png;base64,'; // BEHL season banner, embedded so the app stays a single self-contained file

function makeId(prefix) {
  return prefix + '-' + Math.random().toString(36).slice(2, 9);
}

function isLightColor(hex) {
  if (!hex) return false;
  const m = hex.replace('#', '');
  const r = parseInt(m.substring(0, 2), 16) / 255;
  const g = parseInt(m.substring(2, 4), 16) / 255;
  const b = parseInt(m.substring(4, 6), 16) / 255;
  const lin = (c) => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));
  const lum = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
  return lum > 0.6;
}

function accentText(hex) {
  return isLightColor(hex) ? '#0D1B2A' : '#ffffff';
}

function defaultTeams() {
  return TEAM_COLORS.map((c, i) => ({ id: i, name: TEAM_NAMES[i], color: c }));
}

function baselineOwners(order, total) {
  const owners = [];
  for (let idx = 0; idx < total; idx++) {
    const round = Math.floor(idx / ROUND_SIZE);
    const pos = idx % ROUND_SIZE;
    // Standard snake, except round 11 (index 10) runs in reverse order per league rules.
    const reversed = round === 10 ? true : round % 2 === 1;
    const seq = reversed ? [...order].reverse() : order;
    owners.push(seq[pos]);
  }
  return owners;
}

function parsePool(text) {
  return text
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean)
    .map((line) => {
      const parts = line.split(',');
      const name = parts[0].trim();
      const pos = parts[1] ? parts[1].trim().toUpperCase() : '';
      return { id: makeId('p'), name, pos };
    });
}

export default function HockeyDraft() {
  const [phase, setPhase] = useState('setup');
  const [teams, setTeams] = useState(defaultTeams());
  const [poolText, setPoolText] = useState('');
  const [players, setPlayers] = useState([]);
  const [order, setOrder] = useState([0, 1, 2, 3, 4, 5]);
  const [picks, setPicks] = useState([]);
  const [search, setSearch] = useState('');
  const [loaded, setLoaded] = useState(false);
  const [confirmReset, setConfirmReset] = useState(false);
  const [pickOwners, setPickOwners] = useState([]);
  const [tradeLog, setTradeLog] = useState([]);
  const [tradeOpen, setTradeOpen] = useState(false);
  const [summaryOpen, setSummaryOpen] = useState(false);
  const [playerMoves, setPlayerMoves] = useState({});
  const [tradeTeamA, setTradeTeamA] = useState(0);
  const [tradeTeamB, setTradeTeamB] = useState(1);
  const [selA, setSelA] = useState([]);
  const [selB, setSelB] = useState([]);
  const [secondsLeft, setSecondsLeft] = useState(60);
  const [timerRunning, setTimerRunning] = useState(true);
  const PICK_SECONDS = 60;
  const [flyer, setFlyer] = useState(null);
  const [landed, setLanded] = useState(null);
  const flyerTimers = useRef([]);
  const flyerCardRef = useRef(null);
  const setupBaselineRef = useRef('');

  useEffect(() => {
    (async () => {
      try {
        const res = await window.storage.get(STORAGE_KEY, false);
        if (res && res.value) {
          const s = JSON.parse(res.value);
          if (s.teams) setTeams(s.teams);
          if (s.players) setPlayers(s.players);
          if (s.order) setOrder(s.order);
          if (s.picks) setPicks(s.picks);
          if (s.phase) setPhase(s.phase);
          if (typeof s.poolText === 'string') setPoolText(s.poolText);
          if (s.pickOwners) setPickOwners(s.pickOwners);
          if (s.tradeLog) setTradeLog(s.tradeLog);
          if (s.playerMoves) setPlayerMoves(s.playerMoves);
          setupBaselineRef.current = (s.order || [0, 1, 2, 3, 4, 5]).join(',') + '|' + (s.players ? s.players.length : 0);
        }
      } catch (e) {
        // no saved draft yet
      }
      setLoaded(true);
    })();
  }, []);

  useEffect(() => {
    if (!loaded) return;
    const s = { teams, players, order, picks, phase, poolText, pickOwners, tradeLog, playerMoves };
    window.storage.set(STORAGE_KEY, JSON.stringify(s), false).catch(() => {});
  }, [teams, players, order, picks, phase, poolText, pickOwners, tradeLog, playerMoves, loaded]);

  // While configuring, keep provisional pick ownership in sync with the order and
  // player pool; changing either resets any pre-draft trades.
  useEffect(() => {
    if (phase !== 'setup' || !loaded) return;
    const key = order.join(',') + '|' + players.length;
    if (setupBaselineRef.current === key) return;
    setupBaselineRef.current = key;
    setPickOwners(baselineOwners(order, players.length));
    setTradeLog([]);
  }, [phase, order, players, loaded]);

  const totalRounds = players.length ? Math.ceil(players.length / ROUND_SIZE) : 0;

  const draftedIds = useMemo(() => new Set(picks.map((p) => p.playerId)), [picks]);
  const available = useMemo(() => players.filter((p) => !draftedIds.has(p.id)), [players, draftedIds]);
  const filteredAvailable = useMemo(() => {
    if (!search.trim()) return available;
    const q = search.toLowerCase();
    return available.filter((p) => p.name.toLowerCase().includes(q) || (p.pos || '').toLowerCase().includes(q));
  }, [available, search]);

  const currentPickIndex = picks.length;
  const currentTeamId = pickOwners.length > currentPickIndex ? pickOwners[currentPickIndex] : null;
  const currentTeam = teams.find((t) => t.id === currentTeamId);
  const currentRound = Math.floor(currentPickIndex / ROUND_SIZE) + 1;
  const currentSlot = (currentPickIndex % ROUND_SIZE) + 1;

  // While a pick's animation is in flight, the marquee keeps showing that pick.
  const displayPickIndex = flyer ? flyer.overall - 1 : currentPickIndex;
  const displayTeamId = flyer ? flyer.teamId : currentTeamId;
  const displayTeam = teams.find((t) => t.id === displayTeamId);
  const displayRound = Math.floor(displayPickIndex / ROUND_SIZE) + 1;

  // The next open slot for the team on the clock (suppressed while a pick animates).
  const pendingSlot = phase === 'draft' && !flyer && currentTeamId != null
    ? { teamId: currentTeamId, slotIndex: picks.filter((p) => p.teamId === currentTeamId).length }
    : null;

  const teamPickCounts = useMemo(() => {
    const counts = {};
    teams.forEach((t) => (counts[t.id] = 0));
    pickOwners.forEach((tid) => {
      if (counts[tid] !== undefined) counts[tid] += 1;
    });
    return counts;
  }, [teams, pickOwners]);

  // Reset the pick clock when the next pick actually comes on the clock,
  // which is after the previous pick's animation has landed.
  useEffect(() => {
    if (phase !== 'draft') return;
    setSecondsLeft(PICK_SECONDS);
    setTimerRunning(true);
  }, [phase, displayPickIndex]);

  // Tick the clock down once a second while the draft is live and running.
  // The clock holds while a drafted pick's animation is in flight.
  useEffect(() => {
    if (phase !== 'draft' || !timerRunning || flyer) return;
    if (secondsLeft <= 0) return;
    const id = setInterval(() => {
      setSecondsLeft((s) => (s > 0 ? s - 1 : 0));
    }, 1000);
    return () => clearInterval(id);
  }, [phase, timerRunning, secondsLeft, flyer]);

  // Drive the drafted-player flyer: pop in at centre screen, hold, then fly into the roster slot.
  useEffect(() => {
    if (!flyer) return;
    const card = flyerCardRef.current;
    if (!card) return;
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    card.style.left = Math.max(12, (window.innerWidth - w) / 2) + 'px';
    card.style.top = Math.max(12, window.innerHeight * 0.4 - h / 2) + 'px';
    card.style.transition = 'none';
    card.style.transform = 'scale(0.8)';
    card.style.opacity = '0';
    requestAnimationFrame(() => {
      card.style.transition = 'transform 0.22s ease-out, opacity 0.22s ease-out';
      card.style.transform = 'scale(1)';
      card.style.opacity = '1';
    });
    const t1 = setTimeout(() => {
      const slot = document.getElementById('hdslot-' + flyer.teamId + '-' + flyer.slotIndex);
      if (!slot) {
        setFlyer(null);
        setLanded({ teamId: flyer.teamId, slotIndex: flyer.slotIndex, key: flyer.key });
        return;
      }
      const sr = slot.getBoundingClientRect();
      const cr = card.getBoundingClientRect();
      const dx = sr.left + sr.width / 2 - (cr.left + cr.width / 2);
      const dy = sr.top + sr.height / 2 - (cr.top + cr.height / 2);
      const s = Math.max(0.1, (sr.height * 0.95) / cr.height);
      card.style.transition = 'transform 0.55s cubic-bezier(0.45, 0.05, 0.25, 1), opacity 0.18s ease-in 0.4s';
      card.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + s + ')';
      card.style.opacity = '0';
    }, 780);
    const t2 = setTimeout(() => {
      setFlyer(null);
      setLanded({ teamId: flyer.teamId, slotIndex: flyer.slotIndex, key: flyer.key });
    }, 1360);
    const t3 = setTimeout(() => {
      setLanded((l) => (l && l.key === flyer.key ? null : l));
    }, 2100);
    flyerTimers.current.push(t1, t2, t3);
    return () => {
      flyerTimers.current.forEach(clearTimeout);
      flyerTimers.current = [];
    };
  }, [flyer ? flyer.key : null]);

  function formatClock(s) {
    const m = Math.floor(s / 60);
    const r = s % 60;
    return `${m}:${r < 10 ? '0' : ''}${r}`;
  }

  function clearFlyer() {
    flyerTimers.current.forEach(clearTimeout);
    flyerTimers.current = [];
    setFlyer(null);
    setLanded(null);
  }

  function launchFlyer(info) {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    setLanded(null);
    setFlyer({ ...info, key: makeId('fly') });
  }

  function handlePoolChange(text) {
    setPoolText(text);
    setPlayers(parsePool(text));
  }

  function updateTeamName(id, name) {
    setTeams((ts) => ts.map((t) => (t.id === id ? { ...t, name } : t)));
  }

  function moveOrder(index, dir) {
    setOrder((o) => {
      const next = [...o];
      const j = index + dir;
      if (j < 0 || j >= next.length) return o;
      [next[index], next[j]] = [next[j], next[index]];
      return next;
    });
  }

  function shuffleOrder() {
    setOrder((o) => {
      const next = [...o];
      for (let i = next.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [next[i], next[j]] = [next[j], next[i]];
      }
      return next;
    });
  }

  function startDraft() {
    if (players.length < 6) return;
    if (pickOwners.length !== players.length) {
      setPickOwners(baselineOwners(order, players.length));
      setTradeLog([]);
    }
    setPicks([]);
    setPhase('draft');
  }

  function draftPlayer(playerId) {
    if (phase !== 'draft') return;
    if (flyer) return; // wait for the current pick's animation to land
    const teamId = pickOwners[picks.length];
    const overall = picks.length + 1;
    const round = Math.floor(picks.length / ROUND_SIZE) + 1;
    const slotIndex = picks.filter((p) => p.teamId === teamId).length;
    const nextPicks = [...picks, { playerId, teamId, overall, round }];
    setPicks(nextPicks);
    if (nextPicks.length === players.length) setPhase('complete');
    const player = players.find((pl) => pl.id === playerId);
    const team = teams.find((t) => t.id === teamId);
    if (player && team) {
      launchFlyer({ name: player.name, pos: player.pos, teamId, slotIndex, overall, teamName: team.name, color: team.color });
    }
  }

  function undoPick() {
    if (picks.length === 0) return;
    clearFlyer();
    setPicks((p) => p.slice(0, -1));
    if (phase === 'complete') {
      // Re-entering the draft invalidates post-draft player trades.
      setPlayerMoves({});
      setTradeLog((log) => log.filter((e) => !String(e.id).startsWith('ptrade')));
      setPhase('draft');
    }
  }

  function fullReset() {
    setPhase('setup');
    setPicks([]);
    setPlayers([]);
    setPoolText('');
    setTeams(defaultTeams());
    setOrder([0, 1, 2, 3, 4, 5]);
    setPickOwners([]);
    setTradeLog([]);
    setPlayerMoves({});
    setupBaselineRef.current = '';
    setTradeOpen(false);
    setSummaryOpen(false);
    setSelA([]);
    setSelB([]);
    clearFlyer();
    setConfirmReset(false);
  }

  function upcomingPicksForTeam(teamId) {
    return pickOwners
      .map((tid, idx) => ({ tid, idx }))
      .filter((x) => x.tid === teamId && x.idx >= currentPickIndex)
      .map((x) => ({ idx: x.idx, overall: x.idx + 1, round: Math.floor(x.idx / ROUND_SIZE) + 1 }));
  }

  function toggleSel(list, setList, idx) {
    setList(list.includes(idx) ? list.filter((i) => i !== idx) : [...list, idx]);
  }

  function openTrade() {
    setSelA([]);
    setSelB([]);
    setTradeOpen(true);
  }

  function executeTrade() {
    if (selA.length === 0 && selB.length === 0) return;
    if (tradeTeamA === tradeTeamB) return;
    const teamAObj = teams.find((t) => t.id === tradeTeamA);
    const teamBObj = teams.find((t) => t.id === tradeTeamB);
    if (phase === 'complete') {
      // Post-draft: the selections are player ids changing rosters.
      setPlayerMoves((prev) => {
        const next = { ...prev };
        selA.forEach((pid) => { next[pid] = tradeTeamB; });
        selB.forEach((pid) => { next[pid] = tradeTeamA; });
        Object.keys(next).forEach((pid) => {
          const pk = picks.find((p) => p.playerId === pid);
          if (pk && next[pid] === pk.teamId) delete next[pid];
        });
        return next;
      });
      const nameOf = (pid) => {
        const pl = players.find((x) => x.id === pid);
        return pl ? pl.name : '?';
      };
      const aStr = selA.length ? selA.map(nameOf).join(', ') : 'nothing';
      const bStr = selB.length ? selB.map(nameOf).join(', ') : 'nothing';
      const entry = `${teamAObj.name} sends ${aStr} to ${teamBObj.name} for ${bStr}`;
      setTradeLog((log) => [{ id: makeId('ptrade'), text: entry }, ...log]);
    } else {
      setPickOwners((prev) => {
        const next = [...prev];
        selA.forEach((idx) => (next[idx] = tradeTeamB));
        selB.forEach((idx) => (next[idx] = tradeTeamA));
        return next;
      });
      const aStr = selA.length ? selA.map((idx) => `#${idx + 1}`).join(', ') : 'nothing';
      const bStr = selB.length ? selB.map((idx) => `#${idx + 1}`).join(', ') : 'nothing';
      const entry = `${teamAObj.name} sends ${aStr} to ${teamBObj.name} for ${bStr}`;
      setTradeLog((log) => [{ id: makeId('trade'), text: entry }, ...log]);
    }
    setSelA([]);
    setSelB([]);
  }

  const rosterByTeam = useMemo(() => {
    const map = {};
    teams.forEach((t) => (map[t.id] = []));
    picks.forEach((p) => {
      const owner = playerMoves[p.playerId] !== undefined ? playerMoves[p.playerId] : p.teamId;
      if (map[owner]) map[owner].push(p);
    });
    return map;
  }, [teams, picks, playerMoves]);

  const playerCountOk = players.length >= 6;
  const playerCountMultiple = players.length % 6 === 0;

  return (
    <div className="hd-root">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap');

        .hd-root {
          --pane: #E8EEF4;
          --ice-line: #BCC3CB;
          --navy: #0B2034;
          --steel: #5C6B7A;
          --behl-navy: #0E2841;
          --center-red: #C8102E;
          --silver: #90969D;
          font-family: 'Work Sans', sans-serif;
          background: linear-gradient(155deg, #263E54 0%, #0B2034 50%, #143049 100%);
          color: var(--navy);
          min-height: 100%;
          position: relative;
          border-radius: 12px;
          overflow: hidden;
        }
        .hd-display {
          font-family: 'Oswald', sans-serif;
          text-transform: uppercase;
          letter-spacing: 0.02em;
        }
        .hd-eyebrow {
          font-family: 'Oswald', sans-serif;
          text-transform: uppercase;
          letter-spacing: 0.18em;
          font-size: 11px;
          color: var(--steel);
        }
        .hd-card {
          background: var(--pane);
          border: 1px solid var(--ice-line);
          border-radius: 10px;
        }
        .hd-input {
          width: 100%;
          background: #fff;
          border: 1.5px solid var(--ice-line);
          border-radius: 8px;
          padding: 9px 12px;
          font-family: 'Work Sans', sans-serif;
          font-size: 14px;
          color: var(--navy);
          outline: none;
          transition: border-color 0.15s ease;
        }
        .hd-input:focus { border-color: var(--behl-navy); }
        .hd-btn {
          font-family: 'Oswald', sans-serif;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          font-size: 13px;
          font-weight: 600;
          border-radius: 8px;
          padding: 9px 16px;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          cursor: pointer;
          text-decoration: none;
          border: 1.5px solid var(--ice-line);
          background: var(--pane);
          color: var(--navy);
          transition: all 0.15s ease;
        }
        .hd-btn:hover { border-color: var(--behl-navy); color: var(--behl-navy); }
        .hd-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .hd-btn:disabled:hover { border-color: var(--ice-line); color: var(--navy); }
        .hd-btn-primary {
          background: var(--behl-navy);
          border-color: var(--behl-navy);
          color: #fff;
        }
        .hd-btn-primary:hover { background: #091A2A; color: #fff; }
        .hd-btn-danger { border-color: var(--center-red); color: var(--center-red); }
        .hd-btn-danger:hover { background: var(--center-red); color: #fff; }

        .hd-marquee {
          border-radius: 14px;
          padding: 20px 32px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 22px;
